{
  "name": "@commonworks/agent-team",
  "version": "0.1.16",
  "description": "Agent-team runtime for DeepSeek Harness: seeded-fork subagent generations, a durable lineage journal, and a point-to-point mail server so members can message each other",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./api": "./src/api.js",
    "./seed": "./src/seed.js",
    "./journal": "./src/journal.js",
    "./mailserver": "./src/mailserver.js",
    "./provider": "./src/provider.js"
  },
  "files": [
    "src",
    "scripts",
    "profile",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/*.test.js",
    "verify": "node scripts/verify-module.mjs",
    "prepublishOnly": "npm test && npm run verify && node scripts/verify-clean-release.mjs",
    "release:check": "node scripts/verify-clean-release.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "agent-team",
    "subagent",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subagent": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT"
}
